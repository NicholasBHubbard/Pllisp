program             = { expression } ;

expression          = function-named | value-expression ;

value-expression    = immediate | function-anonymous | function-call | let-expression ;

immediate           = number | string | identifier ;

function-named      = lparen , "fun" , identifier , lambda-list ,
                      [ value-expression ] , rparen ;

function-anonymous  = lparen , "fun" , lambda-list ,
                      value-expression , { value-expression } , rparen ;

function-call       = lparen , ( identifier | function-anonymous ) ,
                      { value-expression } , rparen ;

let-expression      = lparen , "let" , lparen , identifier , expression , rparen ,
                      expression , rparen ;

lambda-list         = lparen , { lambda-parameter } , rparen ;

lambda-parameter    = [ "?" ] , identifier ;

identifier          = ? an identifier-name whose full spelling is not reserved ? ;

identifier-name     = ( lowercase | "_" ) , { letter | digit | "_" } ;

reserved            = "type" | "fun" | "let" ;

number              = integer | float ;

integer             = digit , { digit } ;

float               = integer , "." , integer ;

string              = quote , { string-character | escape-sequence } , quote ;

string-character    = ? any character except double quote, backslash, CR, or LF ? ;

escape-sequence     = backslash , ( quote | backslash | "n" | "r" | "t" ) ;

quote               = '"' ;
backslash           = ? U+005C REVERSE SOLIDUS ? ;

lparen              = "(" ;
rparen              = ")" ;

letter              = lowercase | uppercase ;
lowercase           = ? an ASCII letter from a through z ? ;
uppercase           = ? an ASCII letter from A through Z ? ;
digit               = ? an ASCII digit from 0 through 9 ? ;

ws                  = ws-char , { ws-char } ;
ws-char             = " " | ? tab ? | ? carriage return ? | ? line feed ? ;

comment             = "#" , { comment-character } ;
comment-character   = ? any character except CR or LF ? ;
