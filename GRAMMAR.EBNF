program             = { form } ;

form                = atom | lparen , ( type-declaration | fun | common-form ) , rparen ;
expression          = atom | lparen , ( fun-anonymous | common-form ) , rparen ;
common-form         = let | match | call ;

(* Type declarations *)

type-declaration    = "type" , type-head , variant , { variant } ;
type-head           = type-name
                    | lparen , type-name , type-variable , { type-variable } , rparen ;
variant             = lparen , constructor-name , { type-expression } , rparen ;

type-expression     = type-name
                    | type-variable
                    | lparen , type-name , type-expression , { type-expression } , rparen ;

(* Functions *)

fun                 = "fun" , [ identifier ] , function-tail ;
fun-anonymous       = "fun" , function-tail ;
function-tail       = lambda-list , [ "->" , type-expression ] , function-body ;

lambda-list         = lparen , { lambda-parameter } , rparen ;
lambda-parameter    = identifier , [ ":" , type-expression ] ;

function-body       = expression , { expression } ;

(* Common forms *)

let                 = "let" , let-binding , expression ;
let-binding         = lparen , identifier , [ ":" , type-expression ] , expression , rparen ;

match               = "match" , expression , match-arm , { match-arm } ;
match-arm           = lparen , pattern , expression , rparen ;
pattern             = lparen , constructor-name , { identifier } , rparen ;

call                = callee , { expression } ;
callee              = identifier | constructor-name ;

(* Atoms and names *)

atom                = immediate | identifier ;
immediate           = number | string ;

type-name           = upper-name ;
constructor-name    = upper-name ;
type-variable       = identifier ;

(* Lexical rules *)

identifier          = identifier-name - keyword ;
identifier-name     = ( lowercase | "_" ) , { letter | digit | "_" } ;
upper-name          = uppercase , { letter | digit | "_" } ;
keyword             = "fun" | "let" | "match" | "type" ;

number              = digits , [ "." , digits ] ;
digits              = digit , { digit } ;

string              = quote , { string-character | escape-sequence } , quote ;
string-character    = ? any character except double quote, backslash, CR, or LF ? ;
escape-sequence     = backslash , ( quote | backslash | "n" | "r" | "t" ) ;

lparen              = "(" ;
rparen              = ")" ;
quote               = '"' ;
backslash           = '\' ;

letter              = lowercase | uppercase ;
lowercase           = ? an ASCII letter from a through z ? ;
uppercase           = ? an ASCII letter from A through Z ? ;
digit               = ? an ASCII digit from 0 through 9 ? ;

ws                  = ws-character , { ws-character } ;
ws-character        = " " | ? tab ? | ? carriage return ? | ? line feed ? ;
comment             = "#" , { comment-character } ;
comment-character   = ? any character except CR or LF ? ;
